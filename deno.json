{
  "version": "0.5.0",
  "tasks": {
    "dev": "deno run --env-file-if-exists=.env --watch --allow-net --allow-read --allow-write --allow-env --allow-sys --allow-ffi src/main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys --allow-ffi src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-sys --allow-ffi tests/",
    "test:coverage": "deno test --allow-read --allow-write --allow-env --allow-sys --allow-ffi --coverage tests/",
    "check": "deno check src tests scripts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "db:migrate": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-ffi src/db/migrate-cli.ts",
    "db:reset": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-ffi src/db/reset-cli.ts",
    "db:backup": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-ffi src/db/backup-cli.ts",
    "check:release": "deno run --allow-read scripts/check-release.ts"
  },
  "imports": {
    "@hono/hono": "npm:hono@^4.13.16",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.6.2",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.6.3",
    "@rabbit-company/argon2id": "npm:@rabbit-company/argon2id@^2.1.0",
    "@sqliteai/sqlite-vector": "npm:@sqliteai/sqlite-vector@^1.2.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "better-sqlite3": "npm:better-sqlite3@^13.0.3",
    "zod": "npm:zod@^4.6.7"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "nodeModulesDir": "manual",
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "exclude": [
      "reference_only",
      "docs",
      "bin",
      "build",
      "data",
      "coverage",
      "node_modules",
      "AGENTS.md",
      "CHANGELOG.md"
    ]
  },
  "lint": {
    "exclude": ["reference_only", "build", "data", "coverage", "node_modules"]
  }
}
