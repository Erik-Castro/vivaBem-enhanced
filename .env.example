# Servidor
PORT=3000
ENV=development
DATABASE_PATH=./data/app.db
APP_ORIGIN=http://localhost:3000
# auto = true em produção, false nos demais ambientes
COOKIE_SECURE=auto
LOG_LEVEL=info

# Sessões — em produção JWT_SECRET é obrigatório (mínimo 32 caracteres)
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Argon2id
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# Extensão vetorial (opcional: sobrescreve o binário embutido em bin/sqlite-vector)
VECTOR_EXTENSION_PATH=

# IA / EIE
AI_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_API_MODEL_CHAT_NAME=
AI_API_MODEL_EMBEDDINGS_NAME=
AI_EMBEDDING_DIMENSIONS=
AI_WORKER_INTERVAL=5000
AI_MAX_RETRIES=3
AI_CONFIDENCE_THRESHOLD=0.7
AI_MAX_EVENTS_PER_BATCH=10
AI_CORRELATION_THRESHOLD=50
AI_OLLAMA_URL=http://localhost:11434
AI_MODEL=
